form text {
  color: #515151;
  font-size: large;
  margin:30% 0 8% 9%;
}
form textarea{
  margin-bottom: 60rpx;

}

input {
  font-size: medium;
  padding: 5px 0px;
  border: 1px solid #ccc;
  border-radius: 20px;
  width: 80%;
  margin:1% 0 12% 9%;
}

.desc {
  margin-top: 15rpx;
  width: 80%;
  border: solid 1px gainsboro;
  margin-left:9%;
  border-radius: 20px;
  height: 200rpx;
}

.picker {
  text-decoration: underline;
  color: #618d63;
  margin: 100rpx 0 100rpx 70rpx;
  font-size:larger;
}

.imageRootAll {
  margin: 15rpx 0 60rpx 0;
  display: flex;
  display: -webkit-flex;
  flex-direction: row;
  justify-content: flex-start;
  align-items: center;
  flex-wrap: wrap;
}


.imgItem {
  margin-left: 70rpx;
  position: relative;
  width: 176rpx;
  height: 176rpx;
  background: #e2e2e2;
}

.img {
  width: 100%;
  height: 100%;
}

.closeImg {
  position: absolute;
  right: 0px;
  width: 32rpx;
  height: 32rpx;
}

.photo {
  width: 70%;
  height: 70%;
  margin: 17%;
}