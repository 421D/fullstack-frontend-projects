page {
  background: rgb(238, 238, 238);
  height: 100%;
}
/* 分类相关样式 */
.main {
  width: 100%;
  height: 100%;
}

  /* 左侧栏目 */
.left {
  overflow: auto;
  width: 25%;
  height: 100vh;
  float: left;
  box-sizing: border-box;
  height: 100vh;
}
.left-tab {
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  position: relative;
}

/* 被选中 */
.active {
  color: #81c984;
  background-color: white;
}


/* 右侧 */
.right {
  height: 100vh;
  width: 75%;
  float: right;
  overflow: auto;
  box-sizing: border-box;
  padding-bottom: 90rpx;
}

.right .title {
  font-size:x-small;
  line-height: 60rpx;
  color: gray;
  background-color: white;
  padding: 35rpx 0 0 15rpx;
  height: 60rpx;
}

/*列表  */
.gwc_right_item {
  display: flex;
  align-items: center;
  padding: 30rpx 0rpx;
  background-color: #ffffff
}

.gwc_right_img {
  width: 140rpx;
  height: 140rpx;
  line-height: 140rpx;
  text-align: center;
  margin-left: 10rpx;
  margin-right: 30rpx;
  border: 1px solid #c7c7c7;
}

.gwc_right_root {
  flex: 1;
  min-width: 0
}
.gwc_right_title {
  font-weight: 400;
  font-size: 40rpx;
  width: auto;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  word-wrap: normal;
  word-wrap: break-word;
  word-break: break-all;
}
.gwc_right_sell {
  padding: 10rpx 0;
  font-size:xx-small;
  color: gray;
}

/*加减器*/
.stepper {
  flex: 1;
  display: flex;
  flex-direction: row;
  justify-content: flex-end;
  align-items: center;
  padding-right: 10rpx;
}

/*价格与数量加减器*/
.price-stepper {
  padding-right: 20rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
}

/*价格*/

.gwc_price {
  font-weight: bold;
  font-size: 32rpx;
  color: #52a356;
}

/*人民币符号*/

.gwc_price:before {
  content: "￥";
  font-size: 14px;
}

.jiajian {
  width: 40rpx;
  height: 40rpx;
}

.value_num {
  width: 50rpx;
  text-align: center;
}

/*数量*/

.value {
  font-size:small;
  margin: 0 25rpx;
  /* border: 1px solid #0f0; */
}

/*底部区域  */

.bottom_box {
  width: 100%;
  height: 80rpx;
  position: fixed;
  left: 0;
  bottom: 0px;
  z-index: 100;
  background-color: #c0dac1;
}

.shop_cartBox {
  width: 110rpx;
  height: 110rpx;
  background-color: #81c984;
  border-radius: 50%;
  position: absolute;
  top: -50rpx;
  left: 40rpx;
  border: 1px solid rgb(255, 255, 255);

}

.shopcar_img {
  width: 60rpx;
  height: 60rpx;
  position: absolute;
  top: 27rpx;
  left: 27rpx;
  /* border: 1px solid #0f0; */

}

.all_money {
  position: absolute;
  width: 50%;
  height: 80rpx;
  top: 0;
  left: 25%;
  line-height: 80rpx;
  text-align: center;
  font-size: 32rpx;
}

.choose_ok {
  position: absolute;
  width: 25%;
  height: 80rpx;
  top: 0;
  right: 0;
  line-height: 80rpx;
  text-align: center;
  color: #fff;
  font-size: 40rpx;
  background-color: #66a069;
}


/*弹窗遮罩层  */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.6;
  background: #000;
  z-index: 666;
}

/*购物车弹窗  */

.cart_popup {
  width: 100%;
  height: 285px;
  background: #fff;
  position: fixed;
  z-index: 999;
  left: 0;
  bottom: -285px;
  overflow: auto;
}

.shopcar_title {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  text-align: center;
  position: fixed;
  left: 0;
  background-color: #81c984;
  color: #fff;
}

/*关闭按钮  */

.shopcar_close {
  position: absolute;
  left: 30rpx;
  font-size:x-small;
}

/*清空购物车  */
.shopcar_deleteAll {
  position: absolute;
  right: 30rpx;
  font-size:x-small;
}

/*购物车列表  */
.cart_cells {
  width: 100%;
  height: 110rpx;
  margin-top: 50rpx;
  position: relative;
  border-bottom: 1px #dedede solid;
}

.cells_name {
  width: 40%;
  height: 50%;
  position: absolute;
  top: 0;
  left: 0;
  font-size:medium;
  margin-left: 40rpx;
  padding-top: 10rpx;
   /* 超过9个字省略号 */
   font-weight: 9;
   overflow: hidden;
   text-overflow: ellipsis;
   white-space: nowrap;
   word-wrap: normal;
   word-wrap: break-word;
   word-break: break-all;
}

.cells_price {
  width: 60%;
  height: 50%;
  position: absolute;
  top: 18rpx;
  left: 130rpx;
  margin-left: 40rpx;
  font-size:small;
  padding-bottom: 10rpx;
  color: #81c984;
}
.cells_price:before {
  content: "￥";
  font-size:small;
}

.price-box {
  padding-right: 20rpx;
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  width: 20%;
  position: absolute;
  left: 60%;
  top: 20rpx;
}

/*删除购物车某项  */

.shopcar_delete {
  position: absolute;
  right: 40rpx;
  top: 32rpx;
}


/* 还未登录时的弹窗 */
.toast-box {
  width: 100%;
  height: 100%;
  position: fixed;
  top: 0px;
  left: 0px;
}

.toastbg {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0.6;
  background: #000;
  z-index: 666;
}


.showToast {
  position: absolute;
  background: white;
  opacity: 1;
  width: 100%;
  height: 300rpx;
  bottom: 0;
  z-index: 888;
}

.toast_btn {
  width: 90%;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
}