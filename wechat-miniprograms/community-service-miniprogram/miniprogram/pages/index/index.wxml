<!-- 顶部轮播图 -->
<view>
	<swiper indicator-dots="{{true}}" indicator-color="#81c984" autoplay="true" circular="true">
		<block wx:for="{{banner}}" wx:key="banner">
			<swiper-item bindtap="goHuiShou">
				<image src='{{item.picUrl}}' mode="widthFix" style="width:100%;height:100%;" />
			</swiper-item>
		</block>
	</swiper>
</view>

<!-- 快捷服务 -->
<view class="category-panel">
	<!-- 第一排 -->
	<view class="category-panel">
		<view bindtap='goFabu' class="category-item">
			<image class="category-item-image" src="/images/fabu.png" />
			<text>发布闲置</text>
		</view>
		<view bindtap='goToMall' class="category-item">
			<image class="category-item-image" src="/images/allgoods.png" />
			<text>全部商品</text>
		</view>
		<view bindtap='goWuye' class="category-item">
			<image class="category-item-image" src="/images/info.png" />
			<text>物业资讯</text>
		</view>
		<view bindtap='goKefu' class="category-item">
			<image class="category-item-image" src="/images/info.png" />
			<text>联系客服</text>
		</view>
	</view>
</view>

<!-- 热门闲置商品 -->
<view wx:if="{{goodList&&goodList.length>0}}">
	<view class="hot_tip">最热闲置商品</view>
	<block wx:for="{{goodList}}" wx:key="index">
		<view class="good_item" data-id="{{item._id}}" bindtap="gotoOrder">
			<!-- <view class="good_item" data-id="{{item._id}}" > -->
			<image class="good-img" src="{{item.img[0]}}" />
			<view class="good-root2">
				<view class="good-title" data-index="{{index}}">{{item.name}}</view>
				<view class="price-stepper">
					<view class="good-sell">剩余：{{item.num}} </view>
					<view class="good-price" data-index="{{index}}">￥{{item.price}}</view>
				</view>
			</view>
		</view>
	</block>
</view>