<!--pages/me/me.wxml-->
<view class="header" wx:if="{{isShowUserName}}" bindtap='change'>
  <image class="userinfo-avatar" src="{{userInfo.avatarUrl}}"></image>
  <text class="userinfo-nickname">{{userInfo.realname?userInfo.realname:userInfo.nickName}}</text>
  <text class="tuichu" bindtap="tuichu">退出登录</text>
</view>
<!--如果用户没有授权，显示登陆按钮  -->
<view wx:if="{{!isShowUserName}}" class="btn-login">
  <button type="primary" bindtap="getUserProfile">授权登陆</button>
</view>
<!-- <view class='line_5px' /> -->
<view wx:if="{{isShowUserName}}" class="bigitem">

  <!-- 我的订单 -->
  <view class='my-item' bindtap="goToMyOrder">
  	<image class="my-item-image" src="/images/myorder.png" />
    <text>我的订单</text>
  </view>
  <view class='my-item' bindtap="goToSeller">
    <image class="my-item-image" src="/images/mysell.png" />
    <text>我发布的</text>
  </view>
</view>

<!-- 没有登录就可以显示的 -->

<!-- 我的报事 -->
<view class='my-item2'>
  <view bindtap="goToBaoshi"><button>我的报事</button></view>
  <view class='right_arrow' />
</view>
<!-- 反馈建议 -->
<view class='my-item2'>
  <button open-type="feedback">反馈建议</button>
  <view class='right_arrow' />
</view>
<!-- 在线客服 -->
<view class='my-item2'>
  <button open-type="contact">在线客服</button>
  <view class='right_arrow' />
</view>
<!-- 权限设置 -->
<view class='my-item2'>
  <button open-type="openSetting">权限设置</button>
  <view class='right_arrow' />
</view>
